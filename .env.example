ENVIRONMENT=development
LOG_LEVEL=INFO
SECURITY_HEADERS_ENABLED=true
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()

# Frontend origins for local CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base virtual cash for newly authenticated Supabase users before promotional credits.
INITIAL_USER_BALANCE=0

# One-time virtual cash credit applied when a normal user first logs in and their wallet is created.
JOINING_BONUS_AMOUNT=10000

# Role bootstrap target. Matching this authenticated Supabase email becomes ADMIN.
ADMIN_EMAIL=admin@your-domain.tld

# Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=postgresql://postgres:your-database-password@db.your-project.supabase.co:5432/postgres

# Frontend API URL.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
