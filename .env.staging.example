ENVIRONMENT=staging
LOG_LEVEL=INFO
SECURITY_HEADERS_ENABLED=true
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()

# Explicit staging frontend origins only. Do not use wildcards.
FRONTEND_ORIGINS=https://staging.your-domain.tld

# Base virtual cash for newly authenticated Supabase users before promotional credits.
INITIAL_USER_BALANCE=0

# One-time virtual cash credit applied when a normal user first logs in and their wallet is created.
JOINING_BONUS_AMOUNT=10000

# Role bootstrap target. Matching this authenticated Supabase email becomes ADMIN on first profile creation.
ADMIN_EMAIL=admin@staging.your-domain.tld

# Supabase Auth and PostgreSQL for staging.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-supabase-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-staging-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-staging-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=postgresql://postgres:your-staging-database-password@db.your-staging-project.supabase.co:5432/postgres

# Frontend staging build variables.
VITE_API_BASE_URL=https://api-staging.your-domain.tld
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-staging-supabase-anon-key
