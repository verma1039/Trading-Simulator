# Trading Simulator environment template.
# Copy the relevant values into backend/.env, frontend/.env, Railway, and Vercel.
# Do not commit real .env files or secrets.

# ------------------------------------------------------------
# Environment mode
# ------------------------------------------------------------
# Supported values: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=info

# Explicit opt-in for legacy local SQLAlchemy table creation.
# Keep false/empty for staging and production; Supabase schema is migration-only.
ENABLE_DEV_SCHEMA_CREATE=false

# ------------------------------------------------------------
# Backend: FastAPI / Railway
# ------------------------------------------------------------
# Local development can use SQLite. Staging/production must use the Supabase
# Postgres pooler or direct connection string copied from Supabase.
DATABASE_URL=sqlite:///./trading_sim.db

# Optional legacy local-development schema name. Supabase business tables are
# managed separately by SQL migrations.
DATABASE_SCHEMA=trading_simulator

# Comma-separated browser origins allowed by CORS.
# Development:
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Staging example:
# FRONTEND_ORIGINS=https://your-staging-frontend.vercel.app
# Production example:
# FRONTEND_ORIGINS=https://your-production-frontend.vercel.app

# Supabase Auth / JWT verification.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Optional legacy fallback only. Prefer JWKS above. Do not expose this to Vercel.
SUPABASE_JWT_SECRET=

# Initial cash balance for newly bootstrapped users.
INITIAL_USER_BALANCE=100000

# ------------------------------------------------------------
# Frontend: Vite / Vercel
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Development:
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

# Staging examples:
# VITE_API_BASE_URL=https://your-staging-api.up.railway.app/api/v1
# VITE_WS_BASE_URL=wss://your-staging-api.up.railway.app

# Production examples:
# VITE_API_BASE_URL=https://your-production-api.up.railway.app/api/v1
# VITE_WS_BASE_URL=wss://your-production-api.up.railway.app
